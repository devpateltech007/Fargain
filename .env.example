# Copy to .env at the repo root and fill in. Never commit .env.
# Check what is configured (values are never printed):  npm run check-env
# Also test credentials with one harmless call each:     npm run check-env:live

# --- Server -------------------------------------------------------------------
PORT=3000
# 127.0.0.1 locally (not reachable from your LAN). Render uses 0.0.0.0 via render.yaml.
HOST=127.0.0.1
# Public URL of the backend (ngrok URL locally for webhooks, Render URL when deployed).
PUBLIC_BASE_URL=http://localhost:3000
# Relative paths resolve from the repo root.
DATABASE_PATH=data/fargain.db
LOG_LEVEL=info
# Enables /api/dev/* demo helpers (e.g. simulate-price-drop). Keep false in production unless demoing.
DEV_ROUTES_ENABLED=true
# Shared bearer token the extension and dashboard send to /api/*. Generate a long random string.
FARGAIN_API_TOKEN=

# --- Anthropic (LLM + vision) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Model IDs. Run `npm run check-env:live` to list the IDs your key can use.
ANTHROPIC_MODEL=
ANTHROPIC_VISION_MODEL=

# --- PayPal (SANDBOX ONLY: the backend refuses any other value) ----------------
PAYPAL_ENV=sandbox
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after adding a webhook to the sandbox app (needed for signature verification).
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# --- Channel3 (product search / matching) -------------------------------------
# Dashboard at trychannel3.com. Sent as the x-api-key header.
CHANNEL3_API_KEY=

# --- Instagram messaging (configured in Phase 5) ------------------------------
# App secret used to verify the X-Hub-Signature-256 header on webhook POSTs.
IG_APP_SECRET=
# Any random string you choose; you paste the same value into the Meta webhook settings.
IG_VERIFY_TOKEN=
# Long-lived access token for the Fargain Instagram professional account.
IG_ACCESS_TOKEN=
# Instagram professional account ID of the Fargain account.
IG_ACCOUNT_ID=

# --- Extension build (read by Vite at build time, not by the backend) ---------
# VITE_BACKEND_URL=http://localhost:3000

{
  "manifest_version": 3,
  "name": "Fargain",
  "version": "0.1.0",
  "description": "Intuitive buying experience. Compare prices and review AI-drafted offers before you send.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Fargain"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/mock-seller/*",
        "http://127.0.0.1:3000/mock-seller/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.amazon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "name": "fargain",
  "version": "0.1.0",
  "private": true,
  "description": "Fargain: AI deal-hunting and negotiation agent for buyers. Your agent haggles, PayPal settles.",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "workspaces": [
    "shared",
    "backend",
    "dashboard",
    "extension"
  ],
  "scripts": {
    "postinstall": "npm run build -w @fargain/shared",
    "build": "npm run build -w @fargain/shared && npm run build -w @fargain/backend && npm run build -w @fargain/dashboard && npm run build -w @fargain/extension",
    "dev:backend": "npm run dev -w @fargain/backend",
    "dev:dashboard": "npm run dev -w @fargain/dashboard",
    "build:extension": "npm run build -w @fargain/extension",
    "start": "npm run start -w @fargain/backend",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check-env": "tsx scripts/check-env.ts",
    "check-env:live": "tsx scripts/check-env.ts --live",
    "gen-tokens": "tsx scripts/gen-local-tokens.ts",
    "probe:paypal": "tsx scripts/probe-paypal-orders.ts",
    "probe:meta": "tsx scripts/probe-meta-token.ts",
    "e2e:paypal": "tsx scripts/paypal-e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.0"
  }
}
